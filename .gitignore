# ===========================
# IPS Oman School Platform
# Root .gitignore
# ===========================

# ---- NEVER COMMIT SECRETS ----
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# ---- Node / Next.js ----
node_modules/
.next/
out/
dist/
.npm
.eslintcache
.vercel

# ---- Laravel / PHP ----
backend/vendor/
backend/storage/logs/
backend/storage/app/public/
backend/.env
backend/bootstrap/cache/

# ---- React Native / Expo ----
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/android/
mobile/ios/
mobile/.env*

# ---- MySQL / Database ----
*.sql.gz
*.dump

# ---- OS / Editor ----
.DS_Store
Thumbs.db
*.suo
*.user
.idea/
.vscode/settings.json
*.swp
*.swo

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Build artifacts ----
build/
coverage/
.turbo/
